    {
      "key": "voteSeconds",
      "label": "Vote time",
      "description": "Seconds to vote",
      "type": "number",
      "default": 30,
      "min": 15,
      "max": 60,
      "step": 5
    },
    {
      "key": "hint",
      "label": "Imposter's hint",
      "description": "None = the imposter doesn't even get the category (hard mode)",
      "type": "select",
      "default": "category",
      "options": [
        {
          "value": "category",
          "label": "The category"
        },
        {
          "value": "none",
          "label": "No hint"
        }
      ]
    },
    {
      "key": "lastChance",
