{
  "id": "imposter",
  "name": "Imposter",
  "tagline": "One of you doesn't know the word.",
  "description": "Everyone gets the secret word except the imposter, who only knows the category. Everyone types one word about it, the TV deals the clues, and the room votes. A caught imposter can still steal the round by naming the word.",
  "version": "0.1.0",
  "minPlayers": 4,
  "maxPlayers": 16,
  "estimatedMinutes": 10,
  "estimate": {
    "fixedSeconds": 8,
    "perRoundSeconds": 150,
    "perPlayerPerRoundSeconds": 2,
    "roundsSetting": "rounds"
  },
  "tags": ["bluff", "hidden-roles", "words"],
  "settings": [
    {
      "key": "rounds",
      "label": "Rounds",
      "description": "How many secret words",
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 8,
      "step": 1
    },
    {
      "key": "imposters",
      "label": "Imposters",
      "description": "Auto = one up to 9 players, two from 10; two needs 7 or more players",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ]
    },
    {
      "key": "clueRounds",
      "label": "Clue rounds",
      "description": "Auto = one with talk, two without",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "3",
          "label": "Three"
        }
      ]
    },
    {
      "key": "clueSeconds",
      "label": "Clue time",
      "description": "Seconds to type a clue",
      "type": "number",
      "default": 40,
      "min": 20,
      "max": 90,
      "step": 5
    },
    {
      "key": "talk",
      "label": "Talk it over",
      "description": "A talk timer before the vote (off when remote players have no call)",
      "type": "boolean",
      "default": true
    },
    {
      "key": "talkSeconds",
      "label": "Talk time",
      "description": "Seconds to talk before the vote",
      "type": "number",
      "default": 60,
      "min": 30,
      "max": 180,
      "step": 15
