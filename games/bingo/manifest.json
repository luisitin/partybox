{
  "id": "bingo",
  "name": "Bingo",
  "tagline": "Daub what you hear. Press BINGO! Everyone checks.",
  "description": "Plain 75-ball bingo. The TV calls a number every few seconds; you daub your own card however you like. Press BINGO! and the caller stops while your card goes on the TV for everyone to check: the pattern in green, every square you daubed that was never called in red. Right — you win the round. Wrong — the daubs that were never called are wiped, and the caller carries on.",
  "version": "1.0.0",
  "minPlayers": 1,
  "maxPlayers": 16,
  "estimatedMinutes": 15,
  "tags": ["classic", "luck", "tap", "family"],
  "settings": [
