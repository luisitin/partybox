{
  "id": "bingo",
  "name": "Bingo",
  "icon": "🎱",
  "tagline": "Daub what you hear. Press BINGO! Everyone checks.",
  "description": "Plain 75-ball bingo. The TV calls a number every few seconds and you daub your own card. Press BINGO! and your card goes on the TV for everyone to check: the pattern in green, wrong daubs in red. Right, you win the round. Wrong, those daubs are wiped and the caller carries on.",
  "howToPlay": [
    "Keep your card or swap it. Then the TV calls numbers: daub each one.",
    "Finish the round's pattern, then press BINGO!",
    "Everyone checks your card on the TV. Right wins the round; wrong gets wiped."
  ],
  "version": "1.0.0",
  "minPlayers": 1,
  "maxPlayers": 16,
  "estimatedMinutes": 15,
  "tags": ["classic"],
